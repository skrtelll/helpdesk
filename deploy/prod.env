COMPOSE_PROFILES=airflow

DB_HOST=main_postgres
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=helpdesk_user

ETL_DB_USER=helpdesk_etl
ANALYTICS_DB_NAME=helpdesk

AIRFLOW_DB_HOST=main_postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_ADMIN_USER=admin

S3_ENDPOINT=http://minio:9000
BACKUP_BUCKET=helpdesk-backups
BACKUP_DATABASES="helpdesk helpdesk_analytics"
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

DEPLOY_DIR=/opt/helpdesk
