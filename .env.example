# Шаблон переменных окружения. Локально: cp .env.example .env и заполнить пустые значения.
# На сервере .env генерирует workflow деплоя из GitHub Secrets / Variables — руками не править.
# Значения в одинарных кавычках не интерполируются; одинарную кавычку внутри секретов не используем.

# --- Образы (используются на сервере) ---
IMAGE_REGISTRY=ghcr.io/skrtelll
IMAGE_TAG=latest

# --- Порты, публикуемые наружу ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- PostgreSQL ---
# локально — имя сервиса из docker-compose.local.yml; на сервере — имя контейнера БД
DB_HOST=postgres
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=
# только для docker-compose.local.yml: порт БД на localhost
DB_LOCAL_PORT=5432

# --- Секреты приложения ---
# сгенерировать: openssl rand -base64 48
JWT_SECRET=
ML_INTERNAL_SECRET=
